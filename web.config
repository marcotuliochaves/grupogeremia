<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <system.webServer>

    <!-- Reconhecimento das imagens WebP -->
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap
        fileExtension=".webp"
        mimeType="image/webp"
      />
    </staticContent>

    <!-- Configuração das rotas do React Router -->
    <rewrite>
      <rules>

        <rule
          name="React Router Deep Links"
          stopProcessing="true"
        >
          <match url=".*" />

          <conditions logicalGrouping="MatchAll">

            <!-- Não interfere em arquivos existentes -->
            <add
              input="{REQUEST_FILENAME}"
              matchType="IsFile"
              negate="true"
            />

            <!-- Não interfere em diretórios existentes -->
            <add
              input="{REQUEST_FILENAME}"
              matchType="IsDirectory"
              negate="true"
            />

          </conditions>

          <!-- Direciona rotas para o React -->
          <action
            type="Rewrite"
            url="/index.html"
          />

        </rule>

      </rules>
    </rewrite>

  </system.webServer>

</configuration>